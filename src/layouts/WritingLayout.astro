---
import BaseLayout from "./BaseLayout.astro";

const {
  title,
  description,
  date,
  tags = [],
  hero
} = Astro.props.frontmatter;
---

<BaseLayout title={`${title} — Writing`} description={description}>
  <article>
    <header class="article">
      <div class="article__header">
        <div class="eyebrow">Writing</div>
        <h1>{title}</h1>
        {description && <p class="article__summary">{description}</p>}
        <div class="article__meta">
          {date && <span>{date}</span>}
        </div>
        {tags.length > 0 && (
          <ul class="tag-list">
            {tags.map((tag: string) => <li class="tag">{tag}</li>)}
          </ul>
        )}
      </div>
    </header>

    {hero && (
      <div class="article__hero">
        <img src={hero} alt="" />
      </div>
    )}

    <div class="article prose">
      <slot />
    </div>
  </article>
</BaseLayout>
