---
import BaseLayout from "./BaseLayout.astro";

const {
  title,
  description,
  year,
  status,
  role,
  tags = [],
  hero,
  github,
  external
} = Astro.props.frontmatter;
---

<BaseLayout title={`${title} — Project`} description={description}>
  <article>
    <header class="article">
      <div class="article__header">
        <div class="eyebrow">Project</div>
        <h1>{title}</h1>
        {description && <p class="article__summary">{description}</p>}

        <div class="article__meta">
          {year && <span>{year}</span>}
          {status && <span>{status}</span>}
          {role && <span>{role}</span>}
        </div>

        {tags.length > 0 && (
          <ul class="tag-list">
            {tags.map((tag: string) => <li class="tag">{tag}</li>)}
          </ul>
        )}

        {(github || external) && (
          <div class="button-row">
            {github && <a class="button" href={github}>GitHub</a>}
            {external && <a class="button" href={external}>Project link</a>}
          </div>
        )}
      </div>
    </header>

    {hero && (
      <div class="article__hero">
        <img src={hero} alt="" />
      </div>
    )}

    <div class="article prose">
      <slot />
    </div>
  </article>
</BaseLayout>
