---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";

const services = site.pages.services;
---

<BaseLayout title={`Services — ${site.name}`} description={services.intro}>
  <section class="page-head">
    <div class="container">
      <div class="eyebrow">{services.eyebrow}</div>
      <h1>{services.heading}</h1>
      <p class="lead">{services.intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="service-list">
        {services.items.map((item, index) => (
          <div class="service-row">
            <span class="service-index">{String(index + 1).padStart(2, "0")}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>{services.ctaHeading}</h2>
      <p class="lead">{services.ctaText}</p>
      <div class="button-row">
        <a class="button" href={`mailto:${site.contact.email}`}>Email me</a>
        <a class="button" href="/projects/">See past projects</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding: 86px 0 72px;
  }

  .page-head h1 {
    font-size: clamp(2.7rem, 7vw, 5rem);
    margin-bottom: 25px;
  }

  .service-list {
    border-top: 1px solid var(--border);
  }

  .service-row {
    display: grid;
    grid-template-columns: 60px minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 24px;
    padding: 26px 0;
    border-bottom: 1px solid var(--border);
  }

  .service-index {
    color: var(--muted);
    font-size: 0.86rem;
    padding-top: 2px;
  }

  .service-row h3 {
    margin: 0;
  }

  .service-row p {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 720px) {
    .service-row {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
