---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../config/site";

const modules = import.meta.glob("./*.md", { eager: true });

const posts = Object.entries(modules)
  .map(([path, mod]: any) => ({
    href: `/writing/${path.replace("./", "").replace(".md", "")}/`,
    ...mod.frontmatter
  }))
  .filter((post: any) => post.draft !== true)
  .sort((a: any, b: any) =>
    String(b.date ?? "").localeCompare(String(a.date ?? ""))
  );
---

<BaseLayout
  title="Writing"
  description="Technical writing, engineering notes and build logs."
>
  <section class="page-head">
    <div class="container">
      <div class="eyebrow">{site.pages.writing.eyebrow}</div>
      <h1>{site.pages.writing.heading}</h1>
      <p class="lead">{site.pages.writing.intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="writing-list">
        {posts.map((post: any) => (
          <a class="writing-row" href={post.href}>
            <div>
              <strong>{post.title}</strong>
              {post.description && <p>{post.description}</p>}
            </div>
            <span>{post.date}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding: 86px 0 72px;
  }

  .page-head h1 {
    font-size: clamp(2.7rem, 7vw, 5rem);
    margin-bottom: 25px;
  }

  .writing-list {
    border-top: 1px solid var(--border);
  }

  .writing-row {
    display: flex;
    justify-content: space-between;
    gap: 30px;
    padding: 24px 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
  }

  .writing-row strong {
    font-size: 1.1rem;
  }

  .writing-row p {
    margin: 5px 0 0;
    color: var(--muted);
  }

  .writing-row > span {
    color: var(--muted);
    white-space: nowrap;
  }

  @media (max-width: 620px) {
    .writing-row {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
