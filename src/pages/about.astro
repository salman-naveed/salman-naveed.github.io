---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";

const photos = site.about.photos ?? [];
---

<BaseLayout title={`About — ${site.name}`} description={site.about.lead}>
  <section class="page">
    <div class="container">
      <div class="eyebrow">Profile</div>
      <h1>{site.about.heading}</h1>

      <div class="about-layout">
        <div class="reading-width copy">
          <p class="lead">{site.about.lead}</p>

          {site.about.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}

          {site.about.resumeUrl && (
            <p>
              <a class="text-link" href={site.about.resumeUrl}>
                View résumé →
              </a>
            </p>
          )}
        </div>

        {photos.length > 0 && (
          <div class="photo-grid">
            {photos.map((photo, index) => (
              <figure
                class:list={[
                  "photo",
                  index === 0 && "photo--primary"
                ]}
              >
                <img
                  src={photo.src}
                  alt={photo.alt}
                  loading={index === 0 ? "eager" : "lazy"}
                />

                {photo.caption && (
                  <figcaption>{photo.caption}</figcaption>
                )}
              </figure>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    padding: 86px 0 110px;
  }

  .page h1 {
    font-size: clamp(2.7rem, 7vw, 5rem);
  }

  .about-layout {
    margin-top: 42px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 420px);
    gap: 72px;
    align-items: start;
  }

  .copy {
    margin: 0;
  }

  .copy > p:not(.lead) {
    color: var(--muted);
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .photo {
    margin: 0;
  }

  .photo--primary {
    grid-column: 1 / -1;
  }

  .photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--border);
  }

  .photo--primary img {
    aspect-ratio: 4 / 3;
  }

  .photo figcaption {
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.4;
  }

  @media (max-width: 820px) {
    .about-layout {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .photo-grid {
      max-width: 620px;
    }
  }

  @media (max-width: 520px) {
    .photo-grid {
      grid-template-columns: 1fr;
    }

    .photo--primary {
      grid-column: auto;
    }

    .photo img,
    .photo--primary img {
      aspect-ratio: 4 / 3;
    }
  }
</style>