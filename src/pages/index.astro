---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { site } from "../config/site";

const projectModules = import.meta.glob("./projects/*.md", { eager: true });
const projects = Object.entries(projectModules)
  .map(([path, mod]: any) => ({
    href: path.replace("./projects", "/projects").replace(".md", "/"),
    ...mod.frontmatter
  }))
  .filter((project: any) => project.draft !== true && project.featured === true)
  .sort((a: any, b: any) => (a.order ?? 999) - (b.order ?? 999));

const writingModules = import.meta.glob("./writing/*.md", { eager: true });
const writing = Object.entries(writingModules)
  .map(([path, mod]: any) => ({
    href: path.replace("./writing", "/writing").replace(".md", "/"),
    ...mod.frontmatter
  }))
  .filter((post: any) => post.draft !== true && post.featured === true)
  .sort((a: any, b: any) => (a.order ?? 999) - (b.order ?? 999));
---

<BaseLayout>
  <section class="hero">
    <div class="container">
      <div class="eyebrow">{site.home.eyebrow}</div>
      <h1>{site.name}</h1>
      <p class="descriptor">{site.descriptor}</p>
      <p class="lead">{site.tagline}</p>
      <p class="intro">{site.home.intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <h2>{site.home.projectsHeading}</h2>
          <p class="muted reading-width">{site.home.projectsIntro}</p>
        </div>
        <a class="text-link" href="/projects/">All projects →</a>
      </div>

      <div class="card-grid">
        {projects.map((project: any) => (
          <ProjectCard
            href={project.href}
            title={project.title}
            description={project.description}
            year={project.year}
            hero={project.hero}
            tags={project.tags}
          />
        ))}
      </div>
    </div>
  </section>

  {writing.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-header">
          <div>
            <h2>{site.home.writingHeading}</h2>
            <p class="muted reading-width">{site.home.writingIntro}</p>
          </div>
          <a class="text-link" href="/writing/">All writing →</a>
        </div>

        <div class="writing-list">
          {writing.map((post: any) => (
            <a class="writing-row" href={post.href}>
              <span>{post.title}</span>
              <span>{post.date}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <h2>{site.home.contactHeading}</h2>
      <p class="lead">{site.home.contactText}</p>
      <a class="text-link" href={`mailto:${site.contact.email}`}>
        {site.contact.email} →
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 112px 0 104px;
  }

  .descriptor {
    margin: 18px 0 5px;
    font-size: 1.1rem;
    color: var(--muted);
  }

  .hero .lead {
    margin-top: 26px;
    max-width: 760px;
  }

  .intro {
    max-width: 680px;
    margin-top: 28px;
    color: var(--muted);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 30px;
    margin-bottom: 36px;
  }

  .writing-list {
    border-top: 1px solid var(--border);
  }

  .writing-row {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 17px 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
  }

  .writing-row span:last-child {
    color: var(--muted);
    white-space: nowrap;
  }

  @media (max-width: 650px) {
    .hero {
      padding: 72px 0;
    }

    .section-header {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
